{
    "name": "quillstack/http-request",
    "description": "Common interface for Server Requests and Client Requests.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://quillstack.org/packages/http-request",
    "authors": [
        {
            "name": "Radek Ziemniewicz",
            "email": "radek@quillstack.org"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Quillstack\\HttpRequest\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.6.x-dev"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "quillstack/unit-tests": "^0.9"
    },
    "scripts": {
        "test": "unit-tests",
        "test:coverage": "phpdbg -qrr vendor/bin/unit-tests",
        "stan": "phpstan analyse"
    },
    "autoload-dev": {
        "psr-4": {
            "Quillstack\\HttpRequest\\Tests\\": "tests/"
        }
    }
}
